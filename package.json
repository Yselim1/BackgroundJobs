{
  "name": "backgroundjobs-framework",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "db:start": "docker compose up -d --wait postgres",
    "dev:setup": "npm run db:start && npm run migrate",
    "dev:server": "node --watch --env-file-if-exists=.env --import tsx src/index.ts",
    "dev:worker": "node --watch --env-file-if-exists=.env --import tsx src/worker.ts",
    "dev": "npm run dev:setup && npm run dev:server",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/db/migrate.ts",
    "auth:bootstrap": "tsx src/security/bootstrap.ts",
    "jobs:import": "tsx src/jobs/import.ts",
    "retention": "tsx src/db/retention.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Durable PostgreSQL-backed background job scheduler and runner",
  "dependencies": {
    "cron-parser": "^5.6.2",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
