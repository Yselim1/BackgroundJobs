FROM node:24-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci
COPY src ./src
COPY migrations ./migrations
RUN npm run build

FROM node:24-bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 backgroundjobs \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin backgroundjobs \
    && mkdir -p /work/tmp \
    && chown -R 10001:10001 /work

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build --chown=root:root /app/dist ./dist
COPY --from=build --chown=root:root /app/migrations ./migrations

USER 10001:10001
WORKDIR /work
CMD ["node", "/app/dist/worker.js"]
