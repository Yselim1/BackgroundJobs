DATABASE_URL=postgres://postgres:postgres@localhost:5432/backgroundjobs
DB_POOL_MAX=10
WORKER_CONCURRENCY=4
SCHEDULER_POLL_MS=1000
SHUTDOWN_GRACE_MS=10000
WEBHOOK_CONCURRENCY=2
WEBHOOK_POLL_MS=500
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_REQUEST_TIMEOUT_MS=10000
# Optional global HMAC key; per-job secret storage is deferred to the security milestone.
# WEBHOOK_SIGNING_KEY=replace-with-a-long-random-value
PORT=3000
