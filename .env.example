DATABASE_URL=postgres://postgres:postgres@localhost:5432/backgroundjobs
DB_POOL_MAX=10
WORKER_CONCURRENCY=4
# Optional display name; defaults to hostname:process-id.
# WORKER_NAME=local-worker
WORKER_QUEUES=default
WORKER_HEARTBEAT_MS=5000
EXECUTION_LEASE_MS=20000
WORKER_STALE_MS=30000
SCHEDULER_POLL_MS=1000
SHUTDOWN_GRACE_MS=10000
WEBHOOK_CONCURRENCY=2
WEBHOOK_POLL_MS=500
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_REQUEST_TIMEOUT_MS=10000
# Optional legacy global HMAC key; prefer per-webhook SIGNING_SECRET references.
# WEBHOOK_SIGNING_KEY=replace-with-a-long-random-value
AUTH_SESSION_TTL_MS=43200000
AUTH_SESSION_IDLE_MS=1800000
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false
# Required to create or resolve managed secrets. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# SECRETS_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
PORT=3000
